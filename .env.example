# Neon pooled connection string. Use the dev branch locally, the main branch on Vercel.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Secret that cron-job.org sends in the x-cron-secret header (openssl rand -hex 32)
CRON_SECRET=""
# Token the ESP32 sends in the x-device-token header (openssl rand -hex 32)
DEVICE_TOKEN=""
# Local demo only (never on Vercel): label the dashboard "Synthetic demo data"
NEXT_PUBLIC_DEMO=""
# Seed script only. Must be the Neon DEV branch endpoint id (ep-xxxx), never a generic string.
# npm run seed refuses unless DATABASE_URL contains it, because it empties the data tables.
SEED_DB_MARKER=""
